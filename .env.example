# CUSTOS Environment Variables Template
# Copy this file to .env and adjust values for your environment.

# ── Application Secrets ──────────────────────────────────
CUSTOS_SECRET=custos_production_secret_key_change_me
CUSTOS_ADMIN_PASSWORD=admin@123

# ── Database Configuration ──────────────────────────────
# Default is SQLite local file. For PostgreSQL: postgresql://user:password@localhost:5432/custos
CUSTOS_DATABASE_URI=sqlite:///custos.db

# ── Telegram Notifications ──────────────────────────────
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Google OAuth ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── Update Server ────────────────────────────────────────
CUSTOS_UPDATE_URL=https://raw.githubusercontent.com/VarunThej/custos-stage1/main/version.json
